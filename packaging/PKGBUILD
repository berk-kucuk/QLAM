# Maintainer: Berk Küçük <berkkucukk@proton.me>

pkgname=qlam
pkgver=2.0.0
pkgrel=5
pkgdesc="Warn-first antivirus for Linux: on-access protection for user files, with a desktop app"
arch=('x86_64')
url="https://github.com/berk-kucuk/QLAM"
license=('MIT')
# Python libraries (PyQt6, qtawesome) come from maze-python, the shared Maze
# venv at /opt/maze/venv.
depends=(
    'maze-python'
    'polkit'
    'dbus'
    'systemd'
    'gcc-libs'
    'glibc'
)
makedepends=('cargo')
optdepends=(
    'clamav: extra ClamAV engine (run clamav-daemon; uses ~1 GB RAM)'
)
backup=('etc/qlam/qlamd.toml')
# makepkg's -flto turns the bundled SQLite (C) into GCC bitcode that the Rust
# link can't use; Cargo does its own LTO (see Cargo.toml).
options=('!lto')
install=qlam.install
# LOCAL BUILD: the source tarball is generated from the local working tree by
# ../build-pkg.sh (NOT fetched from GitHub).
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "QLAM-$pkgver/qlamd"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "QLAM-$pkgver/qlamd"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    cd "QLAM-$pkgver/qlamd"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo test --frozen --release
}

package() {
    cd "QLAM-$pkgver"
    local d=qlamd/dist

    # Daemon, bundled rules and system integration
    install -Dm755 qlamd/target/release/qlamd "$pkgdir/usr/lib/qlam/qlamd"
    install -Dm644 -t "$pkgdir/usr/share/qlam/rules" qlamd/rules/qlam-linux.yar qlamd/rules/known-good.txt
    install -Dm644 "$d/qlamd.toml"            "$pkgdir/etc/qlam/qlamd.toml"
    install -Dm644 "$d/qlamd.service"         "$pkgdir/usr/lib/systemd/system/qlamd.service"
    install -Dm644 "$d/qlam-update.service"   "$pkgdir/usr/lib/systemd/system/qlam-update.service"
    install -Dm644 "$d/qlam-update.timer"     "$pkgdir/usr/lib/systemd/system/qlam-update.timer"
    install -Dm644 "$d/org.maze.Qlam1.conf"   "$pkgdir/usr/share/dbus-1/system.d/org.maze.Qlam1.conf"
    install -Dm644 "$d/org.maze.Qlam1.service" "$pkgdir/usr/share/dbus-1/system-services/org.maze.Qlam1.service"
    install -Dm644 "$d/org.maze.qlam.policy"  "$pkgdir/usr/share/polkit-1/actions/org.maze.qlam.policy"
    install -Dm644 "$d/qlam.sysusers"         "$pkgdir/usr/lib/sysusers.d/qlam.conf"
    install -Dm644 "$d/qlam.tmpfiles"         "$pkgdir/usr/lib/tmpfiles.d/qlam.conf"

    # Desktop app
    install -dm755 "$pkgdir/usr/share/qlam"
    cp -r main.py ui resources Logos "$pkgdir/usr/share/qlam/"
    find "$pkgdir/usr/share/qlam" -type d -name __pycache__ -prune -exec rm -rf {} +

    install -Dm755 /dev/stdin "$pkgdir/usr/bin/qlam" << 'EOS'
#!/bin/bash
exec /opt/maze/venv/bin/python3 /usr/share/qlam/main.py "$@"
EOS

    install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/qlam.desktop" << 'EOS'
[Desktop Entry]
Name=Qlam
GenericName=Antivirus
Comment=See and manage what Qlam's protection found
Exec=qlam
Icon=qlam
Terminal=false
Type=Application
Categories=System;Security;
Keywords=antivirus;malware;security;scan;virus;quarantine;
StartupNotify=true
StartupWMClass=qlam
EOS

    # Tray at login, to show warnings as notifications. Users can opt out
    # from Qlam's settings (it writes a Hidden=true override).
    install -Dm644 /dev/stdin "$pkgdir/etc/xdg/autostart/qlam-tray.desktop" << 'EOS'
[Desktop Entry]
Name=Qlam
Comment=Qlam antivirus notifications
Exec=qlam --tray
Icon=qlam
Terminal=false
Type=Application
NoDisplay=true
X-GNOME-Autostart-Delay=5
EOS

    install -Dm644 Logos/qlam.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/qlam.png"
    install -Dm644 Logos/qlam.png "$pkgdir/usr/share/pixmaps/qlam.png"
    if [ -f LICENSE ]; then
        install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    fi
}
