_enable_hint() {
    cat <<'MSG'
==> Qlam: turn protection on with
      sudo systemctl enable --now qlamd.service qlam-update.timer
    and fetch the malware signatures once (a few minutes, ~250 MB download
    the first time):
      sudo systemctl start qlam-update.service
    The known-malware lists (abuse.ch) need a free Auth-Key: get one at
    https://auth.abuse.ch/ and paste it in Qlam > Settings > Signatures.
MSG
}

post_install() {
    _enable_hint
}

post_upgrade() {
    if [ "$(vercmp "$2" 2.0.0)" -lt 0 ]; then
        cat <<'MSG'
==> Qlam 2 replaces the old in-app scanner with the qlamd system service.
    Scan history and quarantine from Qlam 1.x are not migrated; old
    quarantined files stay in ~/.local/share/Qlam/quarantine.
MSG
        _enable_hint
    fi
    if [ "$(vercmp "$2" 2.1.0)" -lt 0 ]; then
        cat <<'MSG'
==> abuse.ch now requires a free Auth-Key for the known-malware lists
    (MalwareBazaar, ThreatFox, URLhaus). Get one at https://auth.abuse.ch/
    and paste it in Qlam > Settings > Signatures.
MSG
    fi
    # Pick up the new binary, rules and unit. pacman's own daemon-reload hook
    # runs after this script, so reload here, or the restart would use the
    # old unit (2.2.0 added a capability the behaviour monitor needs).
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl try-restart qlamd.service >/dev/null 2>&1 || true
}

pre_remove() {
    systemctl disable --now qlamd.service qlam-update.timer >/dev/null 2>&1 || true
}

post_remove() {
    cat <<'MSG'
==> Qlam's state (quarantine, history, signatures) is kept in /var/lib/qlam.
    Remove it by hand if you no longer need it.
MSG
}
