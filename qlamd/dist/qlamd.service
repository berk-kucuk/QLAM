[Unit]
Description=Qlam antivirus daemon
Documentation=https://github.com/berk-kucuk/QLAM
After=local-fs.target dbus.service
Wants=qlam-update.timer

[Service]
Type=dbus
BusName=org.maze.Qlam1
ExecStart=/usr/lib/qlam/qlamd daemon
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2
# Every fanotify event is delivered as an open descriptor; the default soft
# limit of 1024 ran out during a burst of file activity (2026-09-30).
LimitNOFILE=524288

# Root is needed for fanotify permission events and to read/quarantine
# files in every user's home, but not much else.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN
NoNewPrivileges=yes
ProtectSystem=strict
# "-": skip locations that do not exist on this machine.
ReadWritePaths=/var/lib/qlam -/home -/root /tmp /var/tmp /dev/shm -/run/user -/run/media -/media -/mnt
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
# Stay out of the user's way. Scans run at low CPU and I/O priority and
# weight; memory is capped (signatures take ~40 MB, each scan buffer up to
# 50 MB). Under memory pressure Qlam goes before the user's programs: it is
# restarted, and without exec blocking nothing depends on it meanwhile.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=20
IOWeight=20
MemoryHigh=384M
MemoryMax=768M
OOMScoreAdjust=200

[Install]
WantedBy=multi-user.target
